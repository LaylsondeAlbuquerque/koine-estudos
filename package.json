{
  "name": "koine-estudos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma Angular de estudo do grego koiné, compatível com GitHub Pages.",
  "license": "MIT",
  "author": "Laylson de Albuquerque (https://github.com/LaylsondeAlbuquerque)",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "dev": "npm start",
    "build": "ng build && node scripts/finalize-build.mjs",
    "build:pages": "ng build --base-href /koine-estudos/ && node scripts/finalize-build.mjs",
    "validate": "node scripts/validate.mjs",
    "test:logic": "node --test scripts/core.test.mjs scripts/catalog.test.mjs",
    "test": "ng test --watch=false",
    "check": "npm run validate && npm run test:logic && npm test && npm run build:pages",
    "preview": "python scripts/preview-build.py"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0"
  }
}
